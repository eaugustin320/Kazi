# =============================================================================
# Kazi 1.0.0 - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# =============================================================================

# Server Configuration
PORT=3001
HOST=127.0.0.1

# Database Persistence
# Legacy SQLite path (used until the Prisma/PostgreSQL migration is complete)
KAZI_DB_PATH=data/kazi_dev.sqlite
# PostgreSQL (local: docker compose up -d)
DATABASE_URL=postgresql://kazi:change_me@127.0.0.1:5432/kazi_dev
TEST_DATABASE_URL=postgresql://kazi:change_me@127.0.0.1:5432/kazi_test

# Security & Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_session_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here

# External Provider API Keys (SMS Gateway, e.g. Gabon Telecom / Airtel / Infobip)
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=KAZI
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key_here
PAYMENT_GATEWAY_MERCHANT_ID=your_merchant_id_here

# Cloud Storage Credentials (Private verification documents & receipts)
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here
STORAGE_BUCKET=your_storage_bucket_name
STORAGE_REGION=af-south-1

# Client / Frontend Environment
VITE_API_URL=http://127.0.0.1:3001
