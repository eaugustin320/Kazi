{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kazi semantic theme schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "themeId",
    "themeVersion",
    "mode",
    "notes",
    "colors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "themeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mode": {
      "const": "light"
    },
    "notes": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "textMuted",
        "border",
        "controlBorder",
        "primary",
        "onPrimary",
        "primaryHover",
        "accent",
        "onAccent",
        "infoSurface",
        "infoText",
        "successSurface",
        "successText",
        "warningSurface",
        "warningText",
        "dangerSurface",
        "dangerText",
        "focusRing",
        "focusRingOnDark",
        "sidebar",
        "onSidebar"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "textMuted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "controlBorder": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "onPrimary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primaryHover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "onAccent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "infoSurface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "infoText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "successSurface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "successText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "warningSurface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "warningText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "dangerSurface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "dangerText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focusRing": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focusRingOnDark": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "sidebar": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "onSidebar": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
