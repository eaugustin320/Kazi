# =============================================================================
# Kazi 1.0.0 - .gitignore
# Strictly excludes environment variables, secrets, databases, and build artifacts
# =============================================================================

# Environment files & Secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# Databases & Runtime Storage
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm
data/
kazi_data/
tests/temp/

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
.vite/
.next/
*.tsbuildinfo

# Debug logs & Diagnostic dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Extracted packs & Uploaded Archives
Kazi-Agent-Ready-Pack/
*.zip
*.tar.gz
